rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidInventoryItem(data, expectedUserId) {
      return data.keys().hasAll(['id', 'userId', 'createdAt', 'updatedAt', 'title']) &&
             data.userId == expectedUserId &&
             data.id is string &&
             data.title is string;
    }

    // Match user root document and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /inventory/{itemId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId) &&
                      isValidId(userId) &&
                      isValidId(itemId) &&
                      isValidInventoryItem(incoming(), userId);
                      
        allow update: if isOwner(userId) &&
                      existing().userId == userId &&
                      incoming().userId == userId;
                      
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
